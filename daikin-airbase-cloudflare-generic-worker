<script>
const $ = (id) => document.getElementById(id);
let cfg = { schedules: [] };

function K(){
  return localStorage.getItem("daikinApiKey") || "";
}

function msg(value){
  $("msg").textContent =
    typeof value === "string"
      ? value
      : JSON.stringify(value, null, 2);
}

function feedback(id, text, type = "ok"){
  const element = $(id);
  if (!element) return;

  element.textContent = text;
  element.className = "feedback show " + type;

  if (type === "ok"){
    setTimeout(() => {
      element.className = "feedback";
    }, 3500);
  }
}

function buttonBusy(id, busy, busyText, normalText){
  const button = $(id);
  if (!button) return;

  button.disabled = busy;
  button.textContent =
    busy ? busyText : normalText;
}

async function api(path, options = {}){
  const headers = {
    ...(options.headers || {}),
    Authorization: "Bearer " + K(),
  };

  if (options.body){
    headers["Content-Type"] = "application/json";
  }

  const response = await fetch(path, {
    ...options,
    headers,
  });

  const text = await response.text();

  let data;
  try {
    data = JSON.parse(text);
  } catch {
    data = { raw: text };
  }

  if (!response.ok){
    throw new Error(
      data?.error ||
      text ||
      ("HTTP " + response.status)
    );
  }

  return data;
}

function saveKey(){
  localStorage.setItem(
    "daikinApiKey",
    $("key").value.trim()
  );

  feedback(
    "powerFeedback",
    "API key saved in this browser.",
    "ok"
  );

  refreshAll(false);
}

async function live(){
  const data = await api("/status");

  $("indoor").textContent =
    data.sensors.indoorTemperature == null
      ? "—"
      : data.sensors.indoorTemperature + "°C";

  $("outdoor").textContent =
    data.sensors.outdoorTemperature == null
      ? "—"
      : data.sensors.outdoorTemperature + "°C";

  $("power").textContent =
    data.control.power ? "ON" : "OFF";

  $("modeV").textContent =
    data.control.mode || "—";

  $("tempV").textContent =
    data.control.setpoint == null
      ? "—"
      : data.control.setpoint + "°C";

  $("fanV").textContent =
    data.control.fan || "—";

  if (data.control.mode){
    $("mode").value = data.control.mode;
  }

  if (data.control.setpoint != null){
    $("temp").value = data.control.setpoint;
  }

  if (data.control.fan){
    $("fan").value = data.control.fan;
  }

  return data;
}

async function power(on){
  const id =
    on ? "powerOnBtn" : "powerOffBtn";

  try {
    buttonBusy(
      id,
      true,
      on ? "Turning ON…" : "Turning OFF…",
      on ? "Power ON" : "Power OFF"
    );

    feedback(
      "powerFeedback",
      on
        ? "Sending ON command…"
        : "Sending OFF command…",
      "busy"
    );

    const result = await api("/power", {
      method: "POST",
      body: JSON.stringify({ on }),
    });

    feedback(
      "powerFeedback",
      on
        ? "Heat pump turned ON."
        : "Heat pump turned OFF.",
      "ok"
    );

    msg(result);
    await live();
  } catch (error){
    feedback(
      "powerFeedback",
      error.message,
      "err"
    );
    msg(error.message);
  } finally {
    buttonBusy(
      id,
      false,
      "",
      on ? "Power ON" : "Power OFF"
    );
  }
}

async function setMode(){
