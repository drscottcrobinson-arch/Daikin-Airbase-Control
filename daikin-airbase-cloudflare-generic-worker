async function setFan(){
  try {
    const result = await api("/fan", {
      method: "POST",
      body: JSON.stringify({
        fan: $("fan").value,
      }),
    });

    feedback(
      "powerFeedback",
      "Fan setting updated.",
      "ok"
    );

    msg(result);
    await live();
  } catch (error){
    feedback(
      "powerFeedback",
      error.message,
      "err"
    );
  }
}

function scheduleRow(schedule = {}){
  return {
    id:
      schedule.id ||
      (
        "schedule-" +
        Date.now() +
        "-" +
        Math.random().toString(36).slice(2, 6)
      ),
    enabled: schedule.enabled !== false,
    days: Array.isArray(schedule.days)
      ? schedule.days
      : [],
    time: schedule.time || "08:00",
    action:
      schedule.action ||
      {
        type: "on",
        mode: "heat",
        temperature: 23,
        fan: "auto",
      },
  };
}

function addSchedule(){
  cfg.schedules = cfg.schedules || [];
  cfg.schedules.push(scheduleRow());
  renderSchedules();
}

function deleteSchedule(id){
  cfg.schedules =
    (cfg.schedules || [])
      .filter((item) => item.id !== id);

  renderSchedules();
}

function typeChange(select){
  const box = select.closest(".s");
  const onFields = box.querySelector(".onfields");

  onFields.classList.toggle(
    "hide",
    select.value === "off"
  );
}

function modeChange(select){
  const box = select.closest(".s");
  const tempField =
    box.querySelector(".tempfield");

  tempField.classList.toggle(
    "hide",
    select.value === "dry"
  );
}

function renderSchedules(){
  const root = $("schedules");
  root.innerHTML = "";

  const schedules = cfg?.schedules || [];

  if (!schedules.length){
    root.innerHTML =
      '<p class="muted">No schedules configured.</p>';
    return;
  }

  for (const schedule of schedules){
    const s = scheduleRow(schedule);
    const action = s.action || {};
    const selectedDays =
      Array.isArray(s.days) ? s.days : [];

    const element =
      document.createElement("div");

    element.className = "s";
    element.dataset.id = s.id;

    element.innerHTML =
      '<div class="r">' +
        '<label><input data-f="enabled" type="checkbox" ' +
          (s.enabled ? "checked" : "") +
          ' style="width:auto"> Enabled</label>' +
        '<div><label>Time</label>' +
          '<input data-f="time" type="time" value="' +
          (s.time || "08:00") +
          '"></div>' +
        '<div><label>Action</label>' +
          '<select data-f="type" onchange="typeChange(this)">' +
            '<option value="on" ' +
              (action.type === "on" ? "selected" : "") +
              '>ON</option>' +
            '<option value="off" ' +
              (action.type === "off" ? "selected" : "") +
              '>OFF</option>' +
          '</select></div>' +
      '</div>' +

      '<div class="days">' +
        ["mon","tue","wed","thu","fri","sat","sun"]
          .map((day) =>
            '<label><input data-day="' +
            day +
            '" type="checkbox" ' +
            (selectedDays.includes(day) ? "checked" : "") +
            '>' +
            day.toUpperCase() +
            '</label>'
          )
          .join("") +
      '</div>' +

      '<div class="r onfields ' +
        (action.type === "off" ? "hide" : "") +
        '">' +

        '<div><label>Mode</label>' +
          '<select data-f="mode" onchange="modeChange(this)">' +
          ["heat","cool","dry"]
            .map((mode) =>
              '<option ' +
              (action.mode === mode ? "selected" : "") +
              '>' +
              mode +
              '</option>'
            )
            .join("") +
          '</select></div>' +

        '<div class="tempfield ' +
          (action.mode === "dry" ? "hide" : "") +
          '">' +
          '<label>Temperature °C</label>' +
          '<input data-f="temperature" type="number" value="' +
          (action.temperature ?? 23) +
          '">' +
        '</div>' +

        '<div><label>Fan</label>' +
          '<select data-f="fan">' +
          ["auto","low","medium","high"]
            .map((fan) =>
              '<option ' +
              (action.fan === fan ? "selected" : "") +
              '>' +
              fan +
              '</option>'
            )
            .join("") +
          '</select></div>' +

      '</div>' +

      '<button onclick="deleteSchedule(\\'' +
      s.id +
      '\\')">Delete</button>';

    root.appendChild(element);
  }
}

function collectSchedules(){
  return [
    ...document.querySelectorAll(".s"),
  ].map((element) => {
    const type =
      element.querySelector(
        '[data-f="type"]'
      ).value;

    const base = {
      id: element.dataset.id,
      enabled:
        element.querySelector(
          '[data-f="enabled"]'
        ).checked,
      days: [
        ...element.querySelectorAll(
          "[data-day]"
        ),
      ]
        .filter((checkbox) => checkbox.checked)
        .map((checkbox) => checkbox.dataset.day),
      time:
        element.querySelector(
          '[data-f="time"]'
        ).value,
    };

    if (type === "off"){
      return {
        ...base,
        action: { type: "off" },
      };
    }

    const mode =
      element.querySelector(
        '[data-f="mode"]'
      ).value;

    const action = {
      type: "on",
      mode,
      fan:
        element.querySelector(
          '[data-f="fan"]'
        ).value,
    };

    if (mode !== "dry"){
      action.temperature =
        Number(
          element.querySelector(
            '[data-f="temperature"]'
          ).value
        );
    }

    return {
      ...base,
      action,
    };
  });
}

async function loadConfig(){
  const data = await api("/config");
  cfg = data.config;
  renderSchedules();
}

async function saveSchedules(){
  try {
    buttonBusy(
      "saveSchedulesBtn",
      true,
      "Saving…",
      "Save schedules"
    );

    feedback(
      "scheduleFeedback",
      "Saving schedules…",
      "busy"
    );

    const data = await api("/config", {
      method: "PUT",
      body: JSON.stringify({
        schedules: collectSchedules(),
      }),
    });

    cfg = data.config;

    feedback(
      "scheduleFeedback",
      "Schedules saved successfully.",
      "ok"
    );

    msg(data);
    renderSchedules();
  } catch (error){
    feedback(
      "scheduleFeedback",
      error.message,
      "err"
    );
    msg(error.message);
  } finally {
    buttonBusy(
      "saveSchedulesBtn",
      false,
      "",
      "Save schedules"
    );
  }
}

async function refreshAll(showMessage = true){
  if (!K()){
    msg(
      "Open API access and enter the controller API key."
    );
    return;
  }

  try {
    await Promise.all([
      live(),
      loadConfig(),
    ]);

    if (showMessage){
      msg("Updated.");
    }
  } catch (error){
    msg(error.message);
  }
}

$("key").value =
  localStorage.getItem("daikinApiKey") || "";

if (K()){
  refreshAll(false);
}

setInterval(() => {
  if (K()){
    live().catch(() => {});
  }
}, 60000);
</script>

</body>
</html>`;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods":
            "GET,POST,PUT,OPTIONS",
          "Access-Control-Allow-Headers":
            "Authorization,Content-Type",
        },
      });
    }

    try {
      if (
        url.pathname === "/" &&
        request.method === "GET"
      ) {
        return new Response(ui(), {
          headers: {
            "Content-Type":
              "text/html;charset=UTF-8",
            "Cache-Control": "no-store",
          },
        });
      }

      if (
        url.pathname === "/health" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          service: "daikin-airbase-controller",
          now: new Date().toISOString(),
          timezone: timezone(env),
        });
      }

      if (!authorised(request, env)) {
        return json(
          {
            ok: false,
            error: "Unauthorised",
          },
          401
        );
      }

      if (
        url.pathname === "/status" &&
        request.method === "GET"
      ) {
        const [control, sensors, model] =
          await Promise.all([
            getControl(env),
            getSensors(env),
            getModel(env).catch(() => null),
          ]);

        return json({
          ok: true,
          control: publicControl(control),
          sensors: publicSensors(sensors),
          model,
        });
      }

      if (
        url.pathname === "/sensors" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          ...publicSensors(
            await getSensors(env)
          ),
        });
      }

      if (
        url.pathname === "/power" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        let on;

        if (
          typeof parsed.value?.on ===
          "boolean"
        ) {
          on = parsed.value.on;
        } else {
          const value = String(
            parsed.value?.power ??
            parsed.value?.pow ??
            ""
          ).toLowerCase();

          if (
            ["1", "on", "true"].includes(
              value
            )
          ) {
            on = true;
          }

          if (
            ["0", "off", "false"].includes(
              value
            )
          ) {
            on = false;
          }
        }

        if (typeof on !== "boolean") {
          return json(
            {
              ok: false,
              error:
                "Use {on:true} or {on:false}",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            pow: on ? "1" : "0",
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/mode" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const mode = String(
          parsed.value?.mode || ""
        ).toLowerCase();

        if (!MODE[mode]) {
          return json(
            {
              ok: false,
              error:
                "Mode must be heat, cool or dry",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            mode: MODE[mode],
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/setpoint" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const requested = num(
          parsed.value?.temperature ??
          parsed.value?.setpoint,
          null
        );

        if (requested === null) {
          return json(
            {
              ok: false,
              error:
                "temperature must be numeric",
            },
            400
          );
        }

        const current =
          await getControl(env);

        const mode =
          MODE_R[String(current.mode)] ||
          "heat";

        if (mode === "dry") {
          return json(
            {
              ok: false,
              error:
                "Dry mode has no temperature setpoint",
            },
            400
          );
        }

        const temperature =
          mode === "cool"
            ? clamp(requested, 23, 32)
            : clamp(requested, 16, 31);

        const result =
          await modifyControl(env, {
            stemp: String(temperature),
          });

        return json({
          ok: true,
          requestedTemperature:
            requested,
          appliedTemperature:
            temperature,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/fan" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const fan = String(
          parsed.value?.fan || ""
        ).toLowerCase();

        if (!FAN[fan]) {
          return json(
            {
              ok: false,
              error:
                "Fan must be auto, low, medium or high",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            f_rate: FAN[fan],
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/config" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          config: await getConfig(env),
        });
      }

      if (
        url.pathname === "/config" &&
        ["POST", "PUT"].includes(
          request.method
        )
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const current =
          await getConfig(env);

        const incoming =
          parsed.value || {};

        const merged = {
          ...current,
          ...incoming,
          schedules:
            incoming.schedules === undefined
              ? current.schedules
              : incoming.schedules,
        };

        return json({
          ok: true,
          config:
            await saveConfig(
              env,
              merged
            ),
        });
      }

      return json(
        {
          ok: false,
          error: "Not found",
          path: url.pathname,
        },
        404
      );
    } catch (error) {
      console.log(
        "Daikin Worker error:",
        error instanceof Error
          ? error.stack || error.message
          : String(error)
      );

      return json(
        {
          ok: false,
          error:
            error instanceof Error
              ? error.message
              : String(error),
        },
        500
      );
    }
  },

  async scheduled(event, env, ctx) {
    ctx.waitUntil(
      runSchedules(
        env,
        Number.isFinite(
          event?.scheduledTime
        )
          ? event.scheduledTime
          : Date.now()
      )
    );
  },
};
