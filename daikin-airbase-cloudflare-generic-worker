// Generic Daikin Airbase Cloudflare Worker controller
// Solar automation intentionally NOT included.
//
// Required Cloudflare secrets / variables:
//   AIRBASE_ID
//   AIRBASE_PASSWORD
//   AIRBASE_PORT
//   AIRBASE_DEVICE
//   DAIKIN_API_KEY
//
// Required KV binding:
//   DAIKIN_CONFIG
//
// Recommended variable:
//   TIMEZONE   e.g. Pacific/Auckland, Australia/Sydney, Europe/London
//
// Required cron trigger for schedules:
//   * * * * *

const BASE = "https://dascontroller.com/skyfi/aircon";
const CONFIG_KEY = "config";

const MODE = { heat: "1", cool: "2", dry: "7" };
const MODE_R = { "1": "heat", "2": "cool", "7": "dry" };

const FAN = { auto: "0", low: "1", medium: "3", high: "5" };
const FAN_R = { "0": "auto", "1": "low", "3": "medium", "5": "high" };

const DEFAULT_CONFIG = {
  schedules: [],
};

function num(v, fallback = null) {
  const n = Number(v);
  return Number.isFinite(n) ? n : fallback;
}

function clamp(n, min, max) {
  return Math.min(max, Math.max(min, n));
}

function timezone(env) {
  return env.TIMEZONE || "Pacific/Auckland";
}

function json(value, status = 200) {
  return new Response(JSON.stringify(value, null, 2), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      "Access-Control-Allow-Origin": "*",
    },
  });
}

function authorised(request, env) {
  return (
    (request.headers.get("Authorization") || "") ===
    `Bearer ${env.DAIKIN_API_KEY}`
  );
}

async function readJson(request) {
  try {
    return { ok: true, value: await request.json() };
  } catch {
    return { ok: false };
  }
}

function parseCSV(text) {
  const out = {};
  for (const part of String(text || "").trim().split(",")) {
    const i = part.indexOf("=");
    if (i >= 0) {
      out[part.slice(0, i).trim()] = part.slice(i + 1).trim();
    }
  }
  return out;
}

function day3(value) {
  const d = String(value || "").trim().toLowerCase().slice(0, 3);
  return ["mon", "tue", "wed", "thu", "fri", "sat", "sun"].includes(d)
    ? d
    : null;
}

function normaliseDays(value) {
  return Array.isArray(value)
    ? [...new Set(value.map(day3).filter(Boolean))]
    : [];
}

function normaliseAction(schedule) {
  const action = schedule?.action || {};

  if (action.type === "off") {
    return { type: "off" };
  }

  const mode = ["heat", "cool", "dry"].includes(action.mode)
    ? action.mode
    : "heat";

  const fan = ["auto", "low", "medium", "high"].includes(action.fan)
    ? action.fan
    : "auto";

  const result = {
    type: "on",
    mode,
    fan,
  };

  if (mode !== "dry") {
    const t = num(action.temperature, 23);
    result.temperature =
      mode === "cool"
        ? clamp(t, 23, 32)
        : clamp(t, 16, 31);
  }

  return result;
}

function normaliseSchedule(schedule, index = 0) {
  return {
    id: String(
      schedule?.id ||
        `schedule-${Date.now()}-${index}`
    ),
    enabled: schedule?.enabled !== false,
    days: normaliseDays(schedule?.days),
    time: /^([01]\d|2[0-3]):([0-5]\d)$/.test(
      String(schedule?.time || "")
    )
      ? String(schedule.time)
      : "08:00",
    action: normaliseAction(schedule),
  };
}

async function getConfig(env) {
  let stored = null;

  try {
    stored = await env.DAIKIN_CONFIG.get(CONFIG_KEY, {
      type: "json",
    });
  } catch {}

  return {
    ...DEFAULT_CONFIG,
    ...(stored || {}),
    schedules: Array.isArray(stored?.schedules)
      ? stored.schedules.map(normaliseSchedule)
      : [],
  };
}

async function saveConfig(env, config) {
  const clean = {
    schedules: Array.isArray(config?.schedules)
      ? config.schedules.map(normaliseSchedule)
      : [],
  };

  await env.DAIKIN_CONFIG.put(
    CONFIG_KEY,
    JSON.stringify(clean)
  );

  return clean;
}

function airbaseParams(env) {
  for (const key of [
    "AIRBASE_ID",
    "AIRBASE_PASSWORD",
    "AIRBASE_PORT",
    "AIRBASE_DEVICE",
  ]) {
    if (!env[key]) {
      throw new Error(`Missing Cloudflare binding: ${key}`);
    }
  }

  return {
    id: env.AIRBASE_ID,
    spw: env.AIRBASE_PASSWORD,
    port: env.AIRBASE_PORT,
    device: env.AIRBASE_DEVICE,
  };
}

async function airGet(env, endpoint, extra = {}) {
  const url = new URL(`${BASE}/${endpoint}`);

  for (const [key, value] of Object.entries({
    ...airbaseParams(env),
    ...extra,
  })) {
    if (value != null) {
      url.searchParams.set(key, String(value));
    }
  }

  const response = await fetch(url.toString());
  const text = await response.text();

  if (!response.ok) {
    throw new Error(
      `${endpoint} HTTP ${response.status}: ${text}`
    );
  }

  const parsed = parseCSV(text);

  if (
    parsed.ret &&
    !["OK", "ok", "0"].includes(String(parsed.ret))
  ) {
    throw new Error(`${endpoint}: ${text}`);
  }

  return parsed;
}

const getControl = (env) =>
  airGet(env, "get_control_info");

const getSensors = (env) =>
  airGet(env, "get_sensor_info");

const getModel = (env) =>
  airGet(env, "get_model_info");

async function setControl(env, state) {
  const url = new URL(`${BASE}/set_control_info`);

  const all = {
    ...airbaseParams(env),
    ...state,
  };

  delete all.ret;

  for (const [key, value] of Object.entries(all)) {
    if (value == null || value === "") continue;

    if (/^[A-Za-z0-9_]+$/.test(key)) {
      url.searchParams.set(key, String(value));
    }
  }

  const response = await fetch(url.toString());
  const text = await response.text();

  if (!response.ok) {
    throw new Error(
      `set_control_info HTTP ${response.status}: ${text}`
    );
  }

  const parsed = parseCSV(text);

  if (
    parsed.ret &&
    !["OK", "ok", "0"].includes(String(parsed.ret))
  ) {
    throw new Error(`set_control_info: ${text}`);
  }

  return parsed;
}

// Airbase is safest when writes include the full current control state.
// Read the current state, change only the requested field, send it back,
// then read once more to confirm the new state.
async function modifyControl(env, changes) {
  const before = await getControl(env);

  const full = {
    ...before,
    ...changes,
  };

  delete full.ret;

  await setControl(env, full);

  const after = await getControl(env);

  return {
    before,
    after,
  };
}

function publicControl(data) {
  return {
    power: String(data?.pow) === "1",
    mode:
      MODE_R[String(data?.mode)] ||
      data?.mode ||
      null,
    setpoint:
      data?.stemp == null || data.stemp === ""
        ? null
        : num(data.stemp, null),
    fan:
      FAN_R[String(data?.f_rate)] ||
      data?.f_rate ||
      null,
    raw: data || {},
  };
}

function publicSensors(data) {
  return {
    indoorTemperature:
      data?.htemp == null || data.htemp === ""
        ? null
        : num(data.htemp, null),
    outdoorTemperature:
      data?.otemp == null || data.otemp === ""
        ? null
        : num(data.otemp, null),
    raw: data || {},
  };
}

function localParts(env, date = new Date()) {
  const parts = new Intl.DateTimeFormat("en-NZ", {
    timeZone: timezone(env),
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    weekday: "short",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(date);

  const get = (type) =>
    parts.find((x) => x.type === type)?.value || "";

  const weekdayMap = {
    Mon: "mon",
    Tue: "tue",
    Wed: "wed",
    Thu: "thu",
    Fri: "fri",
    Sat: "sat",
    Sun: "sun",
  };

  const hour = Number(get("hour"));
  const minute = Number(get("minute"));

  return {
    day:
      weekdayMap[get("weekday")] ||
      day3(get("weekday")),
    time:
      `${String(hour).padStart(2, "0")}:` +
      `${String(minute).padStart(2, "0")}`,
    dateKey:
      `${get("year")}-${get("month")}-${get("day")}`,
  };
}

function scheduleMatches(env, schedule, date) {
  const local = localParts(env, date);

  return (
    schedule?.enabled === true &&
    normaliseDays(schedule.days).includes(local.day) &&
    String(schedule.time) === local.time
  );
}

async function applySchedule(env, schedule) {
  const action = normaliseAction(schedule);

  if (action.type === "off") {
    return modifyControl(env, {
      pow: "0",
    });
  }

  const changes = {
    pow: "1",
    mode: MODE[action.mode],
    f_rate: FAN[action.fan],
  };

  if (action.mode !== "dry") {
    changes.stemp = String(action.temperature);
  }

  return modifyControl(env, changes);
}

async function runSchedules(env, timestamp = Date.now()) {
  const config = await getConfig(env);
  const date = new Date(timestamp);
  const local = localParts(env, date);

  for (const schedule of config.schedules) {
    if (!scheduleMatches(env, schedule, date)) {
      continue;
    }

    const executionKey =
      `schedule-executed:${local.dateKey}:` +
      `${schedule.id}:${schedule.time}`;

    if (await env.DAIKIN_CONFIG.get(executionKey)) {
      continue;
    }

    await applySchedule(env, schedule);

    await env.DAIKIN_CONFIG.put(
      executionKey,
      String(timestamp),
      { expirationTtl: 172800 }
    );
  }
}

