<script>
const $ = (id) => document.getElementById(id);
let cfg = { schedules: [], schedulesDisabled: false };
let liveState = {
  power: null,
  mode: null,
  setpoint: null,
  fan: null,
};
let liveBusy = false;

function K(){
  return localStorage.getItem("daikinApiKey") || "";
}

function msg(value){
  $("msg").textContent =
    typeof value === "string"
      ? value
      : JSON.stringify(value, null, 2);
}

function feedback(id, text, type = "ok"){
  const element = $(id);
  if (!element) return;

  element.textContent = text;
  element.className = "feedback show " + type;

  if (type === "ok"){
    setTimeout(() => {
      element.className = "feedback";
    }, 3500);
  }
}

function buttonBusy(id, busy, busyText, normalText){
  const button = $(id);
  if (!button) return;

  button.disabled = busy;
  button.textContent =
    busy ? busyText : normalText;
}

async function api(path, options = {}){
  const headers = {
    ...(options.headers || {}),
    Authorization: "Bearer " + K(),
  };

  if (options.body){
    headers["Content-Type"] = "application/json";
  }

  const response = await fetch(path, {
    ...options,
    headers,
  });

  const text = await response.text();

  let data;
  try {
    data = JSON.parse(text);
  } catch {
    data = { raw: text };
  }

  if (!response.ok){
    throw new Error(
      data?.error ||
      text ||
      ("HTTP " + response.status)
    );
  }

  return data;
}

function saveKey(){
  localStorage.setItem(
    "daikinApiKey",
    $("key").value.trim()
  );

  feedback(
    "powerFeedback",
    "API key saved in this browser.",
    "ok"
  );

  refreshAll(false);
}

function pretty(value){
  if (value == null) return "—";
  const s = String(value);
  return s.charAt(0).toUpperCase() + s.slice(1);
}

function updateTempButtons(){
  const down = $("tempDown");
  const up = $("tempUp");

  if (!down || !up) return;

  const temperature = Number(liveState.setpoint);

  if (
    liveState.mode === "dry" ||
    !Number.isFinite(temperature)
  ){
    down.disabled = true;
    up.disabled = true;
    return;
  }

  const min =
    liveState.mode === "cool" ? 23 : 16;

  const max =
    liveState.mode === "cool" ? 32 : 31;

  down.disabled =
    liveBusy || temperature <= min;

  up.disabled =
    liveBusy || temperature >= max;
}

async function live(){
  const data = await api("/status");

  $("indoor").textContent =
    data.sensors.indoorTemperature == null
      ? "—"
      : data.sensors.indoorTemperature + "°C";

  $("outdoor").textContent =
    data.sensors.outdoorTemperature == null
      ? "—"
      : data.sensors.outdoorTemperature + "°C";

  liveState = {
    power: data.control.power === true,
    mode: data.control.mode || null,
    setpoint: data.control.setpoint,
    fan: data.control.fan || null,
  };

  $("power").textContent =
    liveState.power ? "ON" : "OFF";

  $("modeV").textContent =
    pretty(liveState.mode);

  $("tempV").textContent =
    liveState.setpoint == null
      ? "—"
      : liveState.setpoint + "°C";

  $("fanV").textContent =
    pretty(liveState.fan);

  updateTempButtons();

  return data;
}

async function liveCommand(path, payload, successMessage){
  if (liveBusy) return;

  liveBusy = true;
  updateTempButtons();

  feedback(
    "liveFeedback",
    "Sending command…",
    "busy"
  );

  for (const id of [
    "powerTile",
    "modeTile",
    "fanTile",
  ]){
    if ($(id)) $(id).disabled = true;
  }

  try {
    const result = await api(path, {
      method: "POST",
      body: JSON.stringify(payload),
    });

    msg(result);
    await live();

    feedback(
      "liveFeedback",
      successMessage + " Confirmed by Daikin.",
      "ok"
    );
  } catch (error){
    feedback(
      "liveFeedback",
      error.message,
      "err"
    );

    msg(error.message);

    await live().catch(() => {});
  } finally {
    liveBusy = false;

    for (const id of [
      "powerTile",
      "modeTile",
      "fanTile",
    ]){
      if ($(id)) $(id).disabled = false;
    }

    updateTempButtons();
  }
}

async function togglePower(){
  if (liveState.power == null) return;

  const on = !liveState.power;

  await liveCommand(
    "/power",
    { on },
    on ? "Power ON." : "Power OFF."
  );
}

async function cycleMode(){
  const modes = ["heat", "cool", "dry"];
  const currentIndex =
    modes.indexOf(liveState.mode);

  const next =
    modes[
      currentIndex >= 0
        ? (currentIndex + 1) % modes.length
        : 0
    ];

  await liveCommand(
    "/mode",
    { mode: next },
    "Mode changed to " + pretty(next) + "."
  );
}

async function cycleFan(){
  const fans = [
    "auto",
    "low",
    "medium",
    "high",
  ];

  const currentIndex =
    fans.indexOf(liveState.fan);

  const next =
    fans[
      currentIndex >= 0
        ? (currentIndex + 1) % fans.length
        : 0
    ];

  await liveCommand(
    "/fan",
    { fan: next },
    "Fan changed to " + pretty(next) + "."
  );
}

async function adjustTemp(delta){
  if (
    liveBusy ||
    liveState.mode === "dry"
  ){
    return;
  }

  const current =
    Number(liveState.setpoint);

  if (!Number.isFinite(current)) return;

  const min =
    liveState.mode === "cool" ? 23 : 16;

  const max =
    liveState.mode === "cool" ? 32 : 31;

  const next =
    Math.min(
      max,
      Math.max(min, current + delta)
    );

  if (next === current) return;

  await liveCommand(
    "/setpoint",
    { temperature: next },
    "Setpoint changed to " + next + "°C."
  );
}

function renderScheduleMaster(){
  const checkbox = $("disableSchedules");
  const label = $("scheduleMasterState");

  if (!checkbox || !label) return;

  checkbox.checked =
    cfg?.schedulesDisabled === true;

  label.textContent =
    cfg?.schedulesDisabled === true
      ? "All schedules disabled"
      : "Schedules active";
}

const scheduleDays = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
const scheduleMonths = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

function scheduleChoices(names, values, selected){
  return '<div class="schedule-choices">' + names.map((name, i) =>
    '<label><input type="checkbox" value="' + values[i] + '"' +
    (selected.includes(values[i]) ? ' checked' : '') + '> ' + name + '</label>'
  ).join("") + '</div>';
}

function addSchedule(offOnly = false){
  cfg ||= { schedules: [], schedulesDisabled: false };
  cfg.schedules.push({
    id: "schedule-" + crypto.randomUUID(),
    enabled: true, days: ["mon","tue","wed","thu","fri","sat","sun"],
    months: [], time: "08:00", offTime: "", leaveRunning: false,
    action: offOnly ? {type:"off"} : {type:"on",mode:"heat",temperature:23,fan:"auto"}
  });
  renderSchedules();
  editSchedule(cfg.schedules.length - 1, offOnly ? "off" : "on");
}

function scheduleNeedsOff(s){
  return s.enabled && s.action.type === "on" &&
    !s.leaveRunning && (!s.offTime || s.offTime <= s.time);
}

function checkScheduleDraft(){
  const missing = (cfg?.schedules || []).filter(scheduleNeedsOff).length;
  const warning = $("scheduleWarning");
  warning.textContent = missing ? missing + (missing === 1
    ? " schedule needs a turn-off time or Leave running."
    : " schedules need a turn-off time or Leave running.") : "";
  return missing === 0;
}

function renderSchedules(){
  renderScheduleMaster();
  const root = $("schedules");
  root.replaceChildren();
  const schedules = cfg?.schedules || [];
  checkScheduleDraft();
  if (!schedules.length){
    root.textContent = "No schedules configured.";
    return;
  }
  const table = document.createElement("table");
  table.className = "schedule-table";
  table.innerHTML = "<thead><tr><th>Days and months</th><th>Turn on</th><th>Turn off</th></tr></thead>";
  const body = table.createTBody();
  schedules.forEach((s, index) => {
    const row = body.insertRow();
    const days = (s.days || []).map(pretty).join(", ") || "No days";
    const months = (s.months || []).map(month => scheduleMonths[month - 1]).join(", ") || "All year";
    const offOnly = s.action.type === "off";
    const onSettings = [
      s.time, pretty(s.action.mode),
      s.action.mode === "dry" ? "" : s.action.temperature + "°C",
      pretty(s.action.fan) + " fan"
    ].filter(Boolean).join(" · ");
    const cells = [
      ["when", days + " · " + months, s.enabled ? "" : "Disabled"],
      ["on", offOnly ? "—" : onSettings, ""],
      ["off", offOnly ? s.time : s.offTime || (s.leaveRunning ? "Left running" : "No scheduled shut-off"),
        s.offTime && s.offTime <= s.time ? "Must be later than ON" : ""]
    ];
    for (const [part, label, note] of cells){
      const cell = row.insertCell();
      if (part === "on" && offOnly){
        cell.textContent = label;
        continue;
      }
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = note ? label + " · " + note : label;
      if (part === "off" && scheduleNeedsOff(s)) button.className = "schedule-alert";
      button.onclick = () => editSchedule(index, part);
      cell.append(button);
    }
  });
  root.append(table);
}

function editSchedule(index, part){
  const s = cfg.schedules[index];
  const offOnly = s.action.type === "off";
  const dialog = $("scheduleEditor");
  const fields = $("scheduleEditorFields");
  const dayKeys = scheduleDays.map(day => day.toLowerCase());
  const monthKeys = scheduleMonths.map((_, i) => i + 1);
  $("scheduleEditorTitle").textContent = {when:"Days and months",on:"Turn on",off:"Turn off"}[part];
  $("scheduleEditorError").textContent = "";
  $("scheduleLeaveRunning").hidden = part !== "off" || offOnly;
  $("scheduleDelete").hidden = part !== "when";
  if (part === "when"){
    fields.innerHTML =
      '<label><input name="enabled" type="checkbox"' + (s.enabled ? ' checked' : '') + '> Enabled</label>' +
      '<fieldset><legend>Days</legend>' + scheduleChoices(scheduleDays, dayKeys, s.days || []) + '</fieldset>' +
      '<fieldset><legend>Months (none selected means all year)</legend>' +
      scheduleChoices(scheduleMonths, monthKeys, s.months || []) + '</fieldset>';
  } else {
    fields.innerHTML = '<label>Time <input name="time" type="time" required></label>';
    const time = fields.querySelector('[name="time"]');
    time.value = part === "on" || offOnly ? s.time : s.offTime || "";
    if (part === "on"){
      fields.insertAdjacentHTML("beforeend",
        '<label>Mode <select name="mode"><option value="heat">Heat</option><option value="cool">Cool</option><option value="dry">Dry</option></select></label>' +
        '<label data-temp>Temperature °C <input name="temperature" type="number" required></label>' +
        '<label>Fan <select name="fan"><option value="auto">Auto</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label>');
      const mode = fields.querySelector('[name="mode"]');
      const temp = fields.querySelector('[name="temperature"]');
      mode.value = s.action.mode;
      temp.value = s.action.temperature ?? 23;
      fields.querySelector('[name="fan"]').value = s.action.fan;
      mode.onchange = () => {
        temp.disabled = mode.value === "dry";
        temp.closest("[data-temp]").hidden = temp.disabled;
        temp.min = mode.value === "cool" ? 23 : 16;
        temp.max = mode.value === "cool" ? 32 : 31;
        if (Number(temp.value) < Number(temp.min)) temp.value = temp.min;
        if (Number(temp.value) > Number(temp.max)) temp.value = temp.max;
      };
      mode.onchange();
    }
  }
  function finish(){
    dialog.close();
    renderSchedules();
  }
  $("scheduleLeaveRunning").onclick = () => {
    s.offTime = "";
    s.leaveRunning = true;
    finish();
  };
  $("scheduleDelete").onclick = () => {
    cfg.schedules.splice(index, 1);
    finish();
  };
  $("scheduleEditorForm").onsubmit = event => {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    if (part === "when"){
      const groups = fields.querySelectorAll("fieldset");
      const chosen = group => [...group.querySelectorAll("input:checked")].map(input => input.value);
      s.days = chosen(groups[0]);
      s.months = chosen(groups[1]).map(Number);
      s.enabled = data.has("enabled");
    } else if (part === "off" && !offOnly){
      if (data.get("time") <= s.time){
        $("scheduleEditorError").textContent = "Choose a time later than turn-on on the same day.";
        return;
      }
      s.offTime = data.get("time");
      s.leaveRunning = false;
    } else {
      s.time = data.get("time");
      if (!offOnly){
        s.action = {type:"on",mode:data.get("mode"),fan:data.get("fan")};
        if (s.action.mode !== "dry") s.action.temperature = Number(data.get("temperature"));
      }
    }
    finish();
  };
  dialog.showModal();
}

async function loadConfig(){
  const data = await api("/config");
  cfg = data.config;
  renderSchedules();
}

async function saveSchedules(){
  if (!checkScheduleDraft()) return;
  try {
    buttonBusy(
      "saveSchedulesBtn",
      true,
      "Saving…",
      "Save schedules"
    );

    feedback(
      "scheduleFeedback",
      "Saving schedules…",
      "busy"
    );

    const data = await api("/config", {
      method: "PUT",
      body: JSON.stringify({
        schedules: cfg.schedules,
        schedulesDisabled:
          $("disableSchedules").checked,
      }),
    });

    cfg = data.config;

    feedback(
      "scheduleFeedback",
      "Schedules saved successfully.",
      "ok"
    );

    msg(data);
    renderSchedules();
  } catch (error){
    feedback(
      "scheduleFeedback",
      error.message,
      "err"
    );
    msg(error.message);
  } finally {
    buttonBusy(
      "saveSchedulesBtn",
      false,
      "",
      "Save schedules"
    );
  }
}

async function refreshAll(showMessage = true){
  if (!K()){
    msg(
      "Open API access and enter the controller API key."
    );
    return;
  }

  try {
    await Promise.all([
      live(),
      loadConfig(),
    ]);

    if (showMessage){
      msg("Updated.");
    }
  } catch (error){
    msg(error.message);
  }
}

$("key").value =
  localStorage.getItem("daikinApiKey") || "";

if (K()){
  refreshAll(false);
}

setInterval(() => {
  if (K()){
    live().catch(() => {});
  }
}, 60000);
</script>

</body>
</html>`;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname === "/apple-touch-icon.png" &&
        (request.method === "GET" || request.method === "HEAD")) {
      const icon = request.method === "GET"
        ? Uint8Array.from(atob(APPLE_TOUCH_ICON_PNG), char => char.charCodeAt(0))
        : null;
      return new Response(icon, {
        headers: {
          "Content-Type": "image/png",
          "Cache-Control": "public, max-age=86400",
        },
      });
    }

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods":
            "GET,POST,PUT,OPTIONS",
          "Access-Control-Allow-Headers":
            "Authorization,Content-Type",
        },
      });
    }

    try {
      if (
        url.pathname === "/" &&
        request.method === "GET"
      ) {
        return new Response(ui(), {
          headers: {
            "Content-Type":
              "text/html;charset=UTF-8",
            "Cache-Control": "no-store",
          },
        });
      }

      if (
        url.pathname === "/health" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          service: "daikin-airbase-controller",
          now: new Date().toISOString(),
          timezone: timezone(env),
        });
      }

      if (!authorised(request, env)) {
        return json(
          {
            ok: false,
            error: "Unauthorised",
          },
          401
        );
      }

      if (
        url.pathname === "/status" &&
        request.method === "GET"
      ) {
        const [control, sensors, model] =
          await Promise.all([
            getControl(env),
            getSensors(env),
            getModel(env).catch(() => null),
          ]);

        return json({
          ok: true,
          control: publicControl(control),
          sensors: publicSensors(sensors),
          model,
        });
      }

      if (
        url.pathname === "/sensors" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          ...publicSensors(
            await getSensors(env)
          ),
        });
      }

      if (
        url.pathname === "/power" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        let on;

        if (
          typeof parsed.value?.on ===
          "boolean"
        ) {
          on = parsed.value.on;
        } else {
          const value = String(
            parsed.value?.power ??
            parsed.value?.pow ??
            ""
          ).toLowerCase();

          if (
            ["1", "on", "true"].includes(
              value
            )
          ) {
            on = true;
          }

          if (
            ["0", "off", "false"].includes(
              value
            )
          ) {
            on = false;
          }
        }

        if (typeof on !== "boolean") {
          return json(
            {
              ok: false,
              error:
                "Use {on:true} or {on:false}",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            pow: on ? "1" : "0",
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/mode" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const mode = String(
          parsed.value?.mode || ""
        ).toLowerCase();

        if (!MODE[mode]) {
          return json(
            {
              ok: false,
              error:
                "Mode must be heat, cool or dry",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            mode: MODE[mode],
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/setpoint" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const requested = num(
          parsed.value?.temperature ??
          parsed.value?.setpoint,
          null
        );

        if (requested === null) {
          return json(
            {
              ok: false,
              error:
                "temperature must be numeric",
            },
            400
          );
        }

        const current =
          await getControl(env);

        const mode =
          MODE_R[String(current.mode)] ||
          "heat";

        if (mode === "dry") {
          return json(
            {
              ok: false,
              error:
                "Dry mode has no temperature setpoint",
            },
            400
          );
        }

        const temperature =
          mode === "cool"
            ? clamp(requested, 23, 32)
            : clamp(requested, 16, 31);

        const result =
          await modifyControl(env, {
            stemp: String(temperature),
          });

        return json({
          ok: true,
          requestedTemperature:
            requested,
          appliedTemperature:
            temperature,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/fan" &&
        request.method === "POST"
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const fan = String(
          parsed.value?.fan || ""
        ).toLowerCase();

        if (!FAN[fan]) {
          return json(
            {
              ok: false,
              error:
                "Fan must be auto, low, medium or high",
            },
            400
          );
        }

        const result =
          await modifyControl(env, {
            f_rate: FAN[fan],
          });

        return json({
          ok: true,
          control:
            publicControl(result.after),
        });
      }

      if (
        url.pathname === "/config" &&
        request.method === "GET"
      ) {
        return json({
          ok: true,
          config: await getConfig(env),
        });
      }

      if (
        url.pathname === "/config" &&
        ["POST", "PUT"].includes(
          request.method
        )
      ) {
        const parsed = await readJson(request);

        if (!parsed.ok) {
          return json(
            {
              ok: false,
              error: "Invalid JSON",
            },
            400
          );
        }

        const current =
          await getConfig(env);

        const incoming =
          parsed.value || {};

        const merged = {
          ...current,
          ...incoming,
          schedules:
            incoming.schedules === undefined
              ? current.schedules
              : incoming.schedules,
        };

        return json({
          ok: true,
          config:
            await saveConfig(
              env,
              merged
            ),
        });
      }

      return json(
        {
          ok: false,
          error: "Not found",
          path: url.pathname,
        },
        404
      );
    } catch (error) {
      console.log(
        "Daikin Worker error:",
        error instanceof Error
          ? error.stack || error.message
          : String(error)
      );

      return json(
        {
          ok: false,
          error:
            error instanceof Error
              ? error.message
              : String(error),
        },
        500
      );
    }
  },

  async scheduled(event, env, ctx) {
    ctx.waitUntil(
      runSchedules(
        env,
        Number.isFinite(
          event?.scheduledTime
        )
          ? event.scheduledTime
          : Date.now()
      )
    );
  },
};
